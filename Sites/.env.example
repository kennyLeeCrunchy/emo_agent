# Same 32+ character random value must be configured as a Sites secret and locally.
EMO_AGENT_PROXY_SECRET=replace-with-a-random-64-character-secret
EMO_AGENT_PUBLIC_MODE=true

# Local inference protection.
EMO_AGENT_MAX_UPLOAD_BYTES=20971520
EMO_AGENT_REQUESTS_PER_MINUTE=60
EMO_AGENT_EXPENSIVE_REQUESTS_PER_MINUTE=6
EMO_AGENT_MAX_CONCURRENT_ANALYSIS=1

# DeepSeek spend guard. Ordinary chats reserve two credits; native web search
# reserves four because it has additional provider-side search work.
EMO_AGENT_LLM_UPSTREAM_CALLS_PER_DAY=100
EMO_AGENT_LLM_UPSTREAM_CALLS_PER_USER_PER_DAY=20
EMO_AGENT_LLM_MAX_TOOL_ROUNDS=2
EMO_AGENT_LLM_WEB_SEARCH_COST=4
EMO_AGENT_LLM_BUDGET_DB=backend/data/emo_agent_llm_budget.sqlite3

# Existing application secrets. Never commit real values.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_TOKENS=1000
DEEPSEEK_SUMMARY_MAX_TOKENS=1500
DEEPSEEK_MAX_INPUT_CHARS=2000
DEEPSEEK_MAX_HISTORY_CHARS=200000
DEEPSEEK_MAX_TOOL_RESULT_CHARS=3000
DEEPSEEK_MAX_TOOL_RESULTS_TOKENS=6000
DEEPSEEK_CONTEXT_TRIGGER_TOKENS=49152
DEEPSEEK_CONTEXT_TARGET_TOKENS=32768
DEEPSEEK_CONTEXT_HARD_TOKENS=65536
DEEPSEEK_RECENT_MESSAGE_LIMIT=20
DEEPSEEK_RECENT_MESSAGE_KEEP=8
DEEPSEEK_SUMMARY_RETRY_ATTEMPTS=3
DEEPSEEK_SUMMARY_RETRY_DELAY_SECONDS=30
DEEPSEEK_SUMMARY_COOLDOWN_SECONDS=600
DEEPSEEK_ENABLE_WEB_SEARCH=true
EMO_AGENT_MEMORY_DB=backend/data/emo_agent_memory.sqlite3
